# Smart Digital Tailoring System - Environment Variables Example
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xduq1hg.mongodb.net/digitailor_db?retryWrites=true&w=majority
JWT_SECRET=digitailor_jwt_secret_key_2026
PORT=5000

# Google OAuth 2.0 Credentials (Configure from Google Cloud Console https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Frontend Safe Variable (Only GOOGLE_CLIENT_ID, never GOOGLE_CLIENT_SECRET)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Pexels API Key
PEXELS_API_KEY=your_pexels_api_key_here
VITE_PEXELS_API_KEY=your_pexels_api_key_here
